# ============ SuperK-Agent 环境变量模板 ============
# 使用方法：复制本文件为 .env，然后填入真实值
#   cp .env.example .env      (Windows: copy .env.example .env)
# 注意：.env 已被 .gitignore 忽略，永远不会上传到仓库。

# 模型 API Key（必填）—— 阿里云百炼 / DashScope 控制台获取
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Tavily 联网搜索 API Key（可选，用于 web 搜索工具）
# https://tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token（可选，用于 MCP GitHub 服务）
# 需要 repo 权限：https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
